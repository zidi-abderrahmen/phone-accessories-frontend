{
  "name": "phone-accessories-frontend",
  "compatibility_date": "2026-09-05",
  "main": "src/worker.ts",
  "assets": {
    "directory": "./dist/frontend/browser",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "API_URL": "https://phone-accessories-backend.onrender.com"
  }
}